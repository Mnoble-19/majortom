{
  "manifest_version": 3,
  "name": "MajorTom",
  "version": "0.2.0",
  "description": "Dual subtitles and click-to-save vocabulary on any video site.",
  "permissions": [
    "storage",
    "scripting",
    "unlimitedStorage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MajorTom",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
